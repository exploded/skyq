<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Title}}</title>
<style>
{{.CSS}}
</style>
</head>
<body>
<div class="wrap">
{{.NavTop}}
<h1>{{.Title}}</h1>
<p class="sub">{{.Verdict}}</p>

<div class="stats">
{{range .Stats}}  <div class="stat"><div class="k">{{.K}}</div><div class="v">{{.V}} {{if .Small}}<small>&middot; {{.Small}}</small>{{end}}</div></div>
{{end}}</div>

<div class="card">
  <h2>Normalised transparency index, by filter</h2>
  <p class="note">100 = that target and filter's own clear&#8209;sky median ({{.BaselineModeNote}}). Shaded columns are
  autofocus runs; the first target is named at the top left{{if .MultiTarget}} and dashed vertical rules mark each target change{{end}};
  ticks along the base are errors.</p>
  <div class="legend">
{{range .Legend}}    <span><i class="dot" style="background:{{.Color}}"></i>{{.Label}}</span>
{{end}}    <span style="color:var(--critical)">&#9650;<span style="color:var(--text-secondary)">&nbsp;Plate solve failed</span></span>
    <span style="color:var(--warning)">&#9670;<span style="color:var(--text-secondary)">&nbsp;PHD2 error</span></span>
  </div>
  <div class="chartbox" id="b1"><svg id="c1" viewBox="0 0 940 320">{{.IndexChart}}</svg><div class="tip" id="t1"></div></div>
</div>

<div class="card">
  <h2>All&#8209;sky background brightness</h2>
  <p class="note">Mean luminance of the upper sky per all&#8209;sky still &mdash; independent of anything N.I.N.A.
  recorded. The camera auto&#8209;exposes, so this is an instrumental number, not photometry.</p>
{{if .RoofNote}}  <p class="note">{{.RoofNote}}</p>{{end}}
  <div class="chartbox" id="b2"><svg id="c2" viewBox="0 0 940 210">{{.LumChart}}</svg><div class="tip" id="t2"></div></div>
</div>

{{if .Shots}}<div class="card">
  <h2>All&#8209;sky frames at the key moments</h2>
  <p class="note">Times come from the still filenames, so they line up with the charts exactly.</p>
  <div class="shots">
{{range .Shots}}    <div class="shot"><figure><img alt="All-sky at {{.Time}}" src="{{.Src}}"><figcaption><b>{{.Time}}</b> &middot; {{.Note}}</figcaption></figure></div>
{{end}}  </div>
</div>
{{end}}
<div class="card">
  <h2>Clear&#8209;sky reference medians</h2>
  <p class="note">The divisors behind the index &mdash; median detected stars per light sub{{if .HasOnset}} before {{.OnsetHM}}{{end}}.{{if .BaselineFallback}} {{.BaselineFallback}}{{end}}</p>
  <table><thead><tr><th>Target</th><th>Filter</th><th>Median stars</th><th>Frames</th><th>Source</th></tr></thead><tbody>
{{range .Baselines}}    <tr><td>{{.Target}}</td><td>{{.Filter}}</td><td>{{.Median}}</td><td>{{.N}}</td><td>{{.Source}}</td></tr>
{{end}}  </tbody></table>
</div>

<div class="card">
  <h2>Event timeline</h2>
  <p class="note">{{.EventNote}}</p>
  <div>
{{range .Events}}    <div class="evrow"><time>{{.Time}}</time><span class="pill">{{.Kind}}</span><span>{{.Detail}}</span><span class="pill">{{.Cause}}</span></div>
{{end}}  </div>
  <details>
    <summary>All {{len .Frames}} frames{{if .FlatCount}} (excludes the {{.FlatCount}} sky flats — no stars to detect){{end}}</summary>
    <table><thead><tr><th>Time</th><th>Class</th><th>Target</th><th>Filter</th><th>Exp</th><th>Stars</th><th>HFR</th><th>Index</th></tr></thead><tbody>
{{range .Frames}}      <tr><td>{{.Time}}</td><td>{{.Class}}</td><td>{{.Target}}</td><td>{{.Filter}}</td><td>{{.Exp}}</td><td>{{.Stars}}</td><td>{{.HFR}}</td><td>{{.Index}}</td></tr>
{{end}}    </tbody></table>
  </details>
</div>

<p class="foot">{{.Foot}}</p>
{{.NavBottom}}
</div>
<script>
const CH={{.ChartsJSON}};
function hover(c){
  const svg=document.getElementById(c.svg),box=document.getElementById(c.box),tip=document.getElementById(c.tip);
  const W=940,L=54,R=62,T=30,B=c.rail?44:30,H=c.h,pw=W-L-R,ph=H-T-B;
  const X=m=>L+(m/c.span)*pw, Y=v=>T+ph-(Math.min(v,c.ymax)/c.ymax)*ph;
  const cross=svg.querySelector('.cross'),halo=svg.querySelector('.halo');
  const hm=m=>{const t=c.o+m,h=Math.floor(t/60)%24,mm=Math.floor(t%60);return String(h).padStart(2,'0')+':'+String(mm).padStart(2,'0');};
  box.addEventListener('pointermove',e=>{
    const r=svg.getBoundingClientRect(),mm=Math.max(0,Math.min(c.span,((e.clientX-r.left)/r.width*W-L)/pw*c.span));
    let best=null,bs=null,bd=1e9;
    c.series.forEach(s=>s.pts.forEach(p=>{const d=Math.abs(p.m-mm);if(d<bd){bd=d;best=p;bs=s;}}));
    if(!best||bd>14){tip.style.opacity=0;cross.setAttribute('opacity',0);halo.setAttribute('opacity',0);return;}
    cross.setAttribute('x1',X(best.m));cross.setAttribute('x2',X(best.m));cross.setAttribute('opacity',.6);
    halo.setAttribute('cx',X(best.m));halo.setAttribute('cy',Y(best.v));halo.setAttribute('stroke',bs.color);halo.setAttribute('opacity',1);
    const val=c.fmt==='pct'?best.v.toFixed(0)+'%':best.v.toFixed(1);
    tip.innerHTML='<div style="color:var(--text-secondary);margin-bottom:2px">'+hm(best.m)+(best.target?' &middot; '+best.target:'')+'</div>'+
      '<span class="sw" style="background:'+bs.color+'"></span>'+bs.name+' <b>'+val+'</b>'+
      (best.stars!==undefined?' <span style="color:var(--text-secondary)">('+best.stars+' stars)</span>':'');
    tip.style.opacity=1;
    tip.style.left=Math.min(r.width-210,Math.max(0,X(best.m)/W*r.width+12))+'px';
    tip.style.top=Math.max(0,Y(best.v)/H*r.height-46)+'px';
  });
  box.addEventListener('pointerleave',()=>{tip.style.opacity=0;cross.setAttribute('opacity',0);halo.setAttribute('opacity',0);});
}
CH.forEach(hover);
</script>
</body>
</html>
