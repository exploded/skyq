{{define "page"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>skyq — live sky</title>
<style>
{{.CSS}}
/* live-page additions on the same tokens */
.state { display:flex; align-items:baseline; gap:14px; }
.state .flag { font-size:34px; letter-spacing:-.02em; font-weight:650; }
.state.ok .flag { color: var(--series-3); }
.state.bad .flag { color: var(--critical); }
.state.unknown .flag { color: var(--muted); }
.state .why { color: var(--text-secondary); }
.livestill img { width:100%; border-radius:8px; border:1px solid var(--border); display:block; }
.updated { color: var(--muted); font-size:12px; }
</style>
<meta name="htmx-config" content='{"noSwap": [204, 304, "4xx", "5xx"]}'>
<script src="/static/js/htmx.min.js" defer></script>
</head>
<body>
<div class="wrap">
<h1>skyq — live sky</h1>
<p class="sub">Advisory transparency monitor. This device never gates the roof or parks the mount —
cloud is not a safety condition, and unknown never means clear.</p>
{{template "live" .}}
</div>
</body>
</html>
{{end}}

{{define "live"}}
<div id="live" hx-get="/partial" hx-trigger="every 30s" hx-swap="outerMorph" style="min-height:520px">

<div class="card">
  <div class="state {{.StateClass}}">
    <span class="flag">{{.StateLabel}}</span>
    <span class="why">{{if .Reason}}{{.Reason}}{{else}}{{.Dark}}{{end}}</span>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="k">Volatility</div><div class="v">{{.Vol}} <small>&middot; threshold {{.Threshold}}</small></div></div>
  <div class="stat"><div class="k">Sky luminance</div><div class="v">{{.Lum}} <small>&middot; 0&#8211;255</small></div></div>
  <div class="stat"><div class="k">Transparency index</div><div class="v">{{.Index}} <small>&middot; 100 = clear median</small></div></div>
  <div class="stat"><div class="k">Last still</div><div class="v">{{if .StillAge}}{{.StillAge}}{{else}}&mdash;{{end}}</div></div>
</div>

{{if .HasChart}}<div class="card">
  <h2>Tonight&#8217;s sky brightness</h2>
  <div class="chartbox"><svg viewBox="0 0 940 210">{{.Chart}}</svg></div>
</div>{{end}}

{{if .HasStill}}<div class="card livestill">
  <h2>Latest all&#8209;sky still</h2>
  <img src="{{.StillURL}}" alt="Latest all-sky still">
</div>{{end}}

{{if .Events}}<div class="card">
  <h2>Tonight&#8217;s events</h2>
  <div>
{{range .Events}}    <div class="evrow"><time>{{.Time}}</time><span class="pill">{{.Kind}}</span><span>{{.Detail}}</span><span class="pill">{{.Cause}}</span></div>
{{end}}  </div>
</div>{{end}}

<p class="updated">{{if .Weather}}{{.Weather}} &middot; {{end}}{{.FrameCount}} frames tonight &middot; updated {{.Generated}} &middot; refreshes every 30&#8202;s</p>
</div>
{{end}}
